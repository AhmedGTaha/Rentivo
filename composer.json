{
    "name": "ahmedgtaha/rentivo",
    "description": "Rentivo - Multi-agency car rental SaaS",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Rentivo\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Rentivo\\Tests\\": "tests/"
        }
    },
    "require": {
        "google/apiclient": "^2.19",
        "phpmailer/phpmailer": "^7.1",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "migrate": "php scripts/migrate.php",
        "seed": "php scripts/seed.php",
        "serve": "php -S localhost:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
